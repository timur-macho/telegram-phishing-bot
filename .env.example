# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Scan mode:
# LOCAL    -> no external APIs (default)
# EXTENDED -> VirusTotal + OpenRouter when keys exist
SCAN_MODE="LOCAL"

# VirusTotal API (optional in LOCAL mode)
VIRUSTOTAL_API_KEY=""

# OpenRouter API Configuration (optional in LOCAL mode)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Database Configuration
DATABASE_PATH=./data/bot.db

# File Upload Configuration
MAX_FILE_SIZE=67108864
TEMP_DIR=./temp
UPLOADS_DIR=./temp/uploads

# Rate Limiting
RATE_LIMIT_PER_USER=10
RATE_LIMIT_WINDOW=3600

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Data Retention
DATA_RETENTION_DAYS=180
